    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='03 - Operational Impact'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Review Capacity vs Detection</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='12'>Interactive operational Impact analysis based on the 235 day simulation </run>
            <run bold='true' fontalignment='1'>Æ </run>
