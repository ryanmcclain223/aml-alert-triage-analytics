    <worksheet name='Laundering Type Comparison - All'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Network Features Improve Detection, but Results Vary by Laundering Type</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='typology_performance' name='federated.1vn268i1n1qh0h1gpzaei0pcnnj0' />
          </datasources>
          <datasource-dependencies datasource='federated.1vn268i1n1qh0h1gpzaei0pcnnj0'>
            <column caption='Laundering type' datatype='string' name='[Laundering_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;behavioural_change_1&quot;' value='Behavioural Change 1' />
                <alias key='&quot;behavioural_change_2&quot;' value='Behavioural Change 2' />
                <alias key='&quot;bipartite&quot;' value='Bipartite' />
                <alias key='&quot;cash_withdrawal&quot;' value='Cash Withdrawal' />
                <alias key='&quot;cycle&quot;' value='Cycle' />
                <alias key='&quot;deposit_send&quot;' value='Deposit Send' />
                <alias key='&quot;fan_in&quot;' value='Fan In' />
                <alias key='&quot;fan_out&quot;' value='Fan Out' />
                <alias key='&quot;gather_scatter&quot;' value='Gather Scatter' />
                <alias key='&quot;layered_fan_in&quot;' value='Layered Fan In' />
                <alias key='&quot;layered_fan_out&quot;' value='Layered Fan Out' />
                <alias key='&quot;over_invoicing&quot;' value='Over Invoicing' />
                <alias key='&quot;scatter_gather&quot;' value='Scatter Gather' />
                <alias key='&quot;single_large&quot;' value='Single Large' />
                <alias key='&quot;smurfing&quot;' value='Smurfing' />
                <alias key='&quot;stacked_bipartite&quot;' value='Stacked Bipartite' />
                <alias key='&quot;structuring&quot;' value='Structuring' />
              </aliases>
            </column>
            <column datatype='string' name='[Model]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Adaptive LightGBM (11)&quot;' value='Adaptive LightGBM Model + Network' />
                <alias key='&quot;Adaptive LightGBM (9)&quot;' value='Adaptive LightGBM Model' />
                <alias key='&quot;Rules&quot;' value='Rules Based System' />
                <alias key='&quot;Static LightGBM (11)&quot;' value='Static LightGBM Model + Network' />
                <alias key='&quot;Static LightGBM (9)&quot;' value='Static LightGBM Model' />
