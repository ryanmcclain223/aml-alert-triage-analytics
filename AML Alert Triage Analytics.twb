          <calculation class='tableau' formula='37' />
          <range granularity='1' max='60' min='15' />
        </column>
        <column caption='Hourly Investigator Cost' datatype='integer' default-format='c!en_US!&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='40'>
          <calculation class='tableau' formula='40' />
          <range granularity='5' max='100' min='20' />
